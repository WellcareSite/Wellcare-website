    <p style="margin: 14px 0 0; font-size: 20px; color: #EAF4FC;">Make a difference in the lives of children and families every day</p>
  </div>
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" style="position: absolute; left: 0; bottom: -1px; width: 100%; height: 80px; display: block;">
    <path d="M0 50 C 360 10, 720 80, 1080 40 S 1440 30, 1440 30 L1440 80 L0 80 Z" fill="#FFFFFF"/>
  </svg>
</section>

