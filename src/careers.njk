---
layout: base.njk
title: "Careers — Join Our Pediatric Therapy Team in Colorado Springs"
description: "Join Colorado Springs' #1 rated pediatric therapy team. SLP, OT, PT & RBT careers with multi-disciplinary collaboration, mentorship, and clinical leadership. 4.8 stars for culture."
permalink: /careers/
---

<style>
  .role-card {
    text-decoration: none;
    color: #1C2F4D;
    background: #FFFFFF;
    border: 1px solid #E3EAF2;
    border-radius: 18px;
    padding: 24px 20px;
    align-items: center;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
    box-shadow: 0 6px 18px rgba(28,47,77,.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .role-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(28,47,77,.13);
  }
  .role-card.slp { border-top: 5px solid #E57FB3; }
  .role-card.ot  { border-top: 5px solid #F5A623; }
  .role-card.pt  { border-top: 5px solid #8CC63F; }
  .role-card.rbt { border-top: 5px solid #6FB3E3; }

  .role-badge-slp { color: #B4306F; font-weight: 800; font-size: 28px; line-height: 1.1; }
  .role-badge-ot  { color: #A35F00; font-weight: 800; font-size: 28px; line-height: 1.1; }
  .role-badge-pt  { color: #3F7A12; font-weight: 800; font-size: 28px; line-height: 1.1; }
  .role-badge-rbt { color: #1E5FA0; font-weight: 800; font-size: 28px; line-height: 1.1; }

  .role-title { font-weight: 600; font-size: 16px; line-height: 1.35; color: #1C2F4D; }
  .role-apply { margin-top: 8px; font-weight: 700; font-size: 15px; color: #1E5FA0; }

  .careers-hero-title {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 800;
    font-size: 58px;
    line-height: 1.1;
  }
  .why-us-title {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 800;
    font-size: 42px;
    line-height: 1.2;
    color: #1C2F4D;
  }

  @media (max-width: 900px) {
    #roles > div {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
  @media (max-width: 760px) {
    .careers-hero-title {
      font-size: 40px !important;
    }
    .why-us-title {
      font-size: 32px !important;
    }
    .why-us-card {
      padding: 36px 24px !important;
    }
  }
  @media (max-width: 500px) {
    #roles > div {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<!-- HERO -->
<section style="background: linear-gradient(115deg, #1D5A88 0%, #2E86CC 55%, #5AACE0 100%); color: #FFFFFF; position: relative;">
